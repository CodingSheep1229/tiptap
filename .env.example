# Plaid API Credentials
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# Environment: sandbox, development, or production
PLAID_ENV=sandbox

# Plaid Products (comma-separated)
PLAID_PRODUCTS=transactions

# Country Codes (comma-separated)
PLAID_COUNTRY_CODES=US

# Application Settings
APP_HOST=http://localhost:5173

# Database
DB_PATH=plaid_lab.sqlite
